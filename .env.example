# Existing SPLUG server settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SMSPOOL_API_KEY=your-smspool-api-key

# New cheap 5sim route
FIVESIM_API_KEY=your-5sim-api-key
FIVESIM_PRICE_MARGIN=1.8
NGN_PER_USD=1400

# Afrstar Nigeria gateway (merchant portal → API credentials)
AFRSTAR_MERCHANT_SN=your-merchant-code
AFRSTAR_MERCHANT_AK=your-merchant-ak
AFRSTAR_MERCHANT_SK=your-merchant-sk
# Phone sent with deposits (Afrstar requires one); optional
AFRSTAR_DEFAULT_PHONE=08000000000
# In the Afrstar portal set BOTH the Collection and Payout callback URL to:
#   https://your-domain.example/api/gateway
SITE_URL=https://your-domain.example
